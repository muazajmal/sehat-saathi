# Leave DATABASE_URL as SQLite for local demos. For Supabase use the
# "Session pooler" connection string, with the psycopg driver:
# DATABASE_URL=postgresql+psycopg://postgres.xxxx:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
DATABASE_URL=sqlite:///./sehat.db

# Optional. Without it, triage runs on the built-in Urdu/English rules.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional. Without these, WhatsApp replies are logged instead of sent.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=sehat-saathi-verify

# Optional. n8n webhook that rings the duty doctor for urgent cases.
N8N_ESCALATION_WEBHOOK=

CLINIC_NAME=Shifa Family Clinic
CLINIC_TZ=Asia/Karachi
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SEED_DEMO=1
